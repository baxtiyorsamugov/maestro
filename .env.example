# Значения проверяются при старте: бот и админка не поднимутся, пока
# окружение не заполнено. Все претензии печатаются одним списком, поэтому
# заготовки ниже (replace_with_...) проверку намеренно не проходят.

BOT_TOKEN=replace_with_telegram_bot_token

# Default local mode.
# In the Windows exe, the database is created in %LOCALAPPDATA%\Maestro\maestro.db.
DB_DRIVER=sqlite
# Optional custom SQLite path:
# SQLITE_PATH=maestro.db

# Optional MySQL mode for server deployment:
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=maestro_user
# DB_PASS=replace_with_database_password
# DB_NAME=maestro

# Хранилище состояний FSM.
# Без REDIS_URL используется MemoryStorage: незавершённый сценарий записи
# теряется при рестарте бота. Для прода обязательно задать Redis.
# REDIS_URL=redis://localhost:6379/0

ADMIN_USERNAME=admin

# Пароль админки хранится ХЕШЕМ, не открытым текстом.
# Сгенерируйте строку: python scripts/hash_password.py
# и вставьте её целиком сюда.
ADMIN_PASSWORD=scrypt$32768$8$1$замените$на$свой$хеш

# Открытый пароль тоже примется — с предупреждением в логе.
# Так сделано, чтобы существующие установки не сломались при обновлении.

# Не меньше 32 случайных байт, свой для каждого окружения:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SECRET_KEY=replace_with_long_random_secret

# Вторая учётная запись с урезанными правами: смотреть всё, менять только
# записи. Нужна, чтобы администратор на ресепшене разбирал заявки, не имея
# доступа к тарифам и учётным записям клиентов. Необязательна.
# Пароль так же можно хранить хешем.
# ADMIN_MANAGER_USERNAME=manager
# ADMIN_MANAGER_PASSWORD=replace_with_password_or_hash

# Прокси, которым панель верит в заголовке X-Forwarded-For (адреса и сети
# через запятую). От остальных заголовок игнорируется: его пишет кто угодно,
# и доверие к нему позволяло обходить блокировку перебора пароля.
# По умолчанию — localhost (nginx на той же машине). В compose задано отдельно.
# ADMIN_TRUSTED_PROXIES=127.0.0.1,::1

# Вебхук вместо поллинга — боевой режим (docs/DEPLOY.md, «Вебхук»).
# Без WEBHOOK_URL бот работает поллингом, как при локальной разработке.
# Секрет обязателен: без него любой, кто узнал адрес, шлёт поддельные
# апдейты. Только A-Z, a-z, 0-9, «_» и «-», не короче 32 символов:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# WEBHOOK_URL=https://bot.example.uz
# WEBHOOK_SECRET=replace_with_random_string_at_least_32_chars
# WEBHOOK_PATH=/telegram/webhook
# WEBHOOK_HOST=127.0.0.1
# WEBHOOK_PORT=8081

# Ошибки в Sentry. Без DSN ничего не включается — локальная разработка
# идёт без него. В события не попадают ни телефоны, ни telegram_id,
# ни токены: их вычищает observability.before_send.
# SENTRY_DSN=https://...@...ingest.sentry.io/...
# SENTRY_ENVIRONMENT=production

# Соль для маскировки telegram_id в логах. Без неё маскировка остаётся
# затемнением, а не защитой: пространство идентификаторов перебирается.
# LOG_SALT=replace_with_random_string

# Формат логов: text (по умолчанию) или json. В контейнере compose ставит json.
# LOG_FORMAT=json
# LOG_LEVEL=INFO
# Файл с ротацией. В контейнере не нужен: лог идёт в stdout, его вращает Docker.
# LOG_FILE=/var/log/maestro/maestro.log

# Куда присылать ежедневную сводку проблем (свой чат или канал админов).
# Без него сводка не отправляется.
# ALERT_CHAT_ID=-1001234567890
