# Защита от повреждения кириллицы (см. docs/AUDIT.md, A-1).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
max_line_length = 100

[*.{md,yml,yaml,json,toml}]
indent_size = 2

[*.bat]
end_of_line = crlf
