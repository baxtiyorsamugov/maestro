# Secrets
.env

# Virtual environments
venv/
.venv/
.venv_*/

# Python
__pycache__/
.codex_pycache/
*.pyc
*.pyo
*.pyd
*.db

# Logs and runtime output
*.log
nohup
nohup.out

# PyInstaller
build/
dist/

# Конфиги редакторов: у каждого свои, в общем репозитории они только мешают.
.idea/
.vscode/
.obsidian/

# Alembic
migrations/versions/__pycache__/

# Runtime
tmp/

# Дампы базы: держать их в репозитории — это отдать всю базу клиентов
# вместе с клоном.
backups/

# Наследие shared-хостинга. Каталоги живут на сервере и в индекс не входят;
# без этих строк любой `git add -A` затаскивает их обратно.
public/
.well-known/

# Данные coverage — артефакт прогона, а не исходник.
.coverage
htmlcov/
