# Всё, чему не место в образе. Без этого в контейнер уезжают виртуальные
# окружения хоста (несовместимые бинарники), локальная база и секреты.
.git/
.github/
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# Секреты. .env монтируется или передаётся переменными окружения,
# но не запекается в образ: образ уходит в реестр, секрет уйдёт с ним.
.env

# Локальные базы и артефакты
*.db
*.db-journal
*.log
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Наследие shared-хостинга и конфиги редакторов
.htaccess
passenger_wsgi.py
public/
.well-known/
.codex_pycache/
.obsidian/
.idea/
.vscode/
